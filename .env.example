# Database (Neon PostgreSQL — goals & user profiles)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Supabase Auth (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Resend — verification codes (https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM_EMAIL="ProgressAce <onboarding@resend.dev>"

# Canonical public URL (required in production)
# Local:  http://localhost:5000
# Vercel: https://your-app.vercel.app  or  https://progressace.com
NEXT_PUBLIC_SITE_URL="http://localhost:5000"
